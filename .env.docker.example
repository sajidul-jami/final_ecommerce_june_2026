# Copy this file to .env before running docker compose.
# For LAN/mobile testing, set APP_HOST to your machine IP, for example 192.168.1.99.

APP_HOST=192.168.1.99

MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_PORT=3306
DB_NAME=ecommerce

MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET=ecommerce
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

USER_FRONTEND_PORT=3000
USER_BACKEND_PORT=3005
ADMIN_FRONTEND_PORT=3002
ADMIN_BACKEND_PORT=3001

USER_JWT_SECRET=local_user_jwt_secret_change_me
ADMIN_JWT_SECRET=local_admin_jwt_secret_change_me
